# Rabbitty Backend Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rabbitty

# Security - REQUIRED: Generate with: openssl rand -base64 32
SECRET_KEY=change-this-to-a-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token-from-botfather

# App Settings
DEBUG=false
APP_NAME=Rabbitty API
APP_VERSION=1.0.0

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://rabbitty.me

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Points System
DEFAULT_REWARD_PERCENTAGE=5.0
REFERRAL_POINTS=50.0
POINTS_TO_BUNZ_RATIO=1.0

# QR Codes
QR_EXPIRY_HOURS=24
