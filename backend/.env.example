# Rabbitty Backend Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rabbitty

# Security - CHANGE IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token-from-botfather

# App Settings
DEBUG=false
APP_NAME=Rabbitty API
APP_VERSION=1.0.0

# CORS
CORS_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Points System
DEFAULT_REWARD_PERCENTAGE=5.0
REFERRAL_POINTS=50.0
POINTS_TO_BUNZ_RATIO=1.0

# QR Codes
QR_EXPIRY_HOURS=24
