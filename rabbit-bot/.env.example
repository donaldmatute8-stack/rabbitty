# === REQUIRED ===

# Telegram Bot Token for @rabbittybot_bot
TELEGRAM_BOT_TOKEN=

# Rabbitty Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# === OLLAMA (AI) ===

# Ollama API URL
# Local:    http://127.0.0.1:11434
# Tailscale: http://100.x.x.x:11434
# Cloud:    https://api.ollama.com
OLLAMA_URL=http://127.0.0.1:11434

# Ollama API Key (required for cloud models)
# Get yours at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Ollama model name
OLLAMA_MODEL=gemma4:31b-cloud

# === OPTIONAL ===

# HTTP port for health checks (Railway sets this automatically)
PORT=8080
