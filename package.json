{
  "name": "rabbitty",
  "version": "1.0.0",
  "private": true,
  "description": "Give to Get - The Bunz reward ecosystem",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "build:landing": "turbo run build --filter={landing-page}",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "security:audit": "pnpm audit --audit-level=high",
    "security:audit:all": "pnpm audit",
    "security:check": "npx --yes snyk test 2>/dev/null || echo 'Snyk no instalado. Ejecuta: npm install -g snyk && snyk auth'",
    "security:deps": "pnpm audit --audit-level=moderate && pnpm outdated"
  },
  "keywords": [
    "web3",
    "rewards",
    "polygon",
    "nft",
    "telegram",
    "mini-app"
  ],
  "author": "Bull's Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/donaldmatute8-stack/rabbitty.git"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  }
}
