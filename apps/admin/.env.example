# Database
RESTAURANT_DATABASE_URL=postgres://rabbitty:rabbitty_dev@localhost:5432/rabbitty_restaurant
CORE_DATABASE_URL=postgres://rabbitty:rabbitty_dev@localhost:5432/rabbitty_core

# Auth
AUTH_SECRET=your-auth-secret-at-least-32-chars
AUTH_RESEND_KEY=re_xxxxx
AUTH_TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Miniapp Bridge
RABBITTY_MINIAPP_URL=http://localhost:3000
RABBITTY_API_SECRET=your-rabbitty-api-secret

# Encryption (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# WebAuthn (Passkeys) & TOTP
RP_NAME=Rabbitty Admin
RP_ID=localhost
ORIGIN=http://localhost:3003

# Domains
RABBITTY_DOMAIN=http://localhost:3003

# Cron job auth (used by /api/cron/birthdays and /api/cron/inventory-forecast)
CRON_SECRET=your-cron-secret-change-in-prod

# Webhooks
AGGREGATOR_WEBHOOK_SECRET=your-aggregator-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_BRANCH_ID=b1
BRANCH_ID=b1

# ── POS · sesión de terminal (flags globales; apagados por defecto) ──
# No son por tenant: al activarlos, cada negocio decide vincular o no sus
# dispositivos desde /pos/link. Sin terminal vinculada, el POS sigue usando
# la sesión del admin.
# POS_TERMINAL_SESSIONS=1
# POS_OPERATOR_SESSIONS=1      # requiere POS_TERMINAL_SESSIONS
# POS_ROLE_ENFORCEMENT=1       # opcional: aplica la matriz de roles también al panel admin
# POS_TERMINAL_PEPPER=cambia-esto-en-produccion
# Aviso al dueño cuando una terminal pide autorización: se manda por la APP
# NATIVA (outbox + APNs del proyecto mobile). Telegram queda como respaldo.
# RABBITTY_MINIAPP_URL=https://app.rabbitty.me
# PUSH_SEND_SECRET=el-mismo-valor-que-tiene-el-proyecto-mobile-en-Vercel
#   ⚠️ Si cambias el pepper después de vincular terminales, hay que revincularlas
#      (el hash del deviceKey deja de coincidir).

# OLLAMA AI ENGINE
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ── PANEL DE VALIDACIÓN (GOD, read-only) ──────────────────────────────────────
# Muestra los snapshots que genera scripts/validation-snapshot.mjs.
# No escribe, no migra y no calcula economía: solo lee JSON de una carpeta.
# Apagado por defecto.
# GOD_VALIDATION_PANEL=true
# Carpeta de snapshots. En local: apps/admin/documents/validation
# En Railway: monta un volumen (p. ej. /data/validation) y apunta aquí,
# porque el filesystem del contenedor es efímero.
# GOD_VALIDATION_DIR=/data/validation
