# Telegram alerts for new business applications (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Neon database connection string for persisting leads (required for DB persistence)
CORE_DATABASE_URL=

# Resend API key to send the confirmation email to applicants (optional)
RESEND_API_KEY=

# Telegram bot username used to build the magic link (optional, default: Rabbittyme_bot)
NEXT_PUBLIC_BOT_USERNAME=Rabbittyme_bot

# WhatsApp number in international format for the "Agilizar" CTA (optional, default: 5213312345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=5213312345678

# Enlaces de la app (TestFlight mientras no haya App Store pública)
NEXT_PUBLIC_IOS_APP_URL=https://testflight.apple.com/join/HyY1eVSU
NEXT_PUBLIC_ANDROID_APP_URL=https://rabbitty.me/rabbitty-app.apk

# Alta de negocios (canal oficial) y login del panel
NEXT_PUBLIC_BUSINESS_ONBOARDING_URL=/negocios
NEXT_PUBLIC_BUSINESS_LOGIN_URL=https://admin.rabbitty.me/login
